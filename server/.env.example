# ---------- Core ----------
NODE_ENV=production
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/ai_leadgen

# Public URLs (replace leadgen.example.com with your domain)
APP_URL=https://leadgen.example.com
API_URL=https://leadgen.example.com
CORS_ORIGINS=https://leadgen.example.com

# Generate each with: openssl rand -base64 48
JWT_SECRET=
ENCRYPTION_KEY=
JWT_EXPIRES_IN=7d

# Comma-separated emails that get the Platform admin dashboard
PLATFORM_ADMIN_EMAILS=prawinkumar2k4@gmail.com

# ---------- AI (Claude) ----------
# false = free mode: rule-based lead scores and template email drafts, no AI cost.
# true  = Claude scores leads (workflow 2) and writes drafts (workflow 3). Needs Anthropic credits.
AI_ENABLED=false
# Direct mode only. In n8n mode Claude runs inside n8n.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# ---------- Discovery ----------
# OpenStreetMap discovery is always available and free.
# Set true once workflow 1 has a Google Places credential (n8n mode) to offer Google as a source too.
GOOGLE_PLACES_ENABLED=false
# Direct mode only. In n8n mode the key lives in the n8n "Google Places API Key" credential.
GOOGLE_PLACES_API_KEY=
PLACES_CACHE_DAYS=30

# ---------- Website analyzer ----------
ANALYZER_URL=http://127.0.0.1:8000
# Same value as the analyzer's ANALYZER_TOKEN (openssl rand -hex 24)
ANALYZER_TOKEN=
# URL n8n uses to reach the analyzer (only if n8n is on another host)
ANALYZER_PUBLIC_URL=https://leadgen.example.com/analyzer

# ---------- Automation ----------
# n8n = run the five n8n workflows; direct = run everything in this server (no n8n needed)
AUTOMATION_MODE=n8n
N8N_BASE_URL=https://n8n.dealpost.co.in
# Must equal the "Value" of the n8n credential "LeadGen Webhook Auth" (openssl rand -hex 32)
N8N_WEBHOOK_SECRET=
N8N_WEBHOOK_HEADER=X-LeadGen-Key

# Direct-mode sending only (e.g. smtps://user:app-password@smtp.gmail.com:465)
SMTP_URL=

# ---------- Billing (optional, Razorpay) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MARKETPLACE_FEE_PERCENT=15

# Set to false if you run the worker as a separate PM2 process
RUN_WORKER=true
LOG_LEVEL=info
